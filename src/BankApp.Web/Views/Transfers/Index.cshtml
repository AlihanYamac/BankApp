@model IReadOnlyList<TransferHistoryDto>
@{
    ViewData["Title"] = "Transfer Geçmişi";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Transfer Geçmişi</h2>
    <a class="btn btn-primary" asp-action="Create">Yeni Transfer</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-light">Henüz transfer işleminiz yok.</div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Tarih</th>
                        <th>Referans</th>
                        <th>Yön / Tür</th>
                        <th>Karşı Taraf</th>
                        <th>Açıklama</th>
                        <th class="text-end">Tutar</th>
                        <th class="text-end">Komisyon</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td class="text-nowrap small">@Fmt.Date(t.CreatedAt)</td>
                            <td class="small">@t.ReferenceNo</td>
                            <td>
                                @if (t.IsIncoming)
                                {
                                    <span class="badge text-bg-success">Gelen</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Giden</span>
                                    <span class="small text-muted">@Fmt.TransferTypeName(t.Type)</span>
                                }
                            </td>
                            <td class="small">
                                @t.CounterpartyName
                                <div class="iban text-muted">@Fmt.Iban(t.IsIncoming ? t.FromIban : t.ToIban)</div>
                            </td>
                            <td class="small">@t.Description</td>
                            <td class="text-end text-nowrap @(t.IsIncoming ? "amount-in" : "amount-out")">
                                @(t.IsIncoming ? "+" : "-")@Fmt.Money(t.Amount)
                            </td>
                            <td class="text-end text-nowrap small">@Fmt.Money(t.Fee)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
