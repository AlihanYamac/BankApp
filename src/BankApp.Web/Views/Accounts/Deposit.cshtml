@model DepositViewModel
@{
    ViewData["Title"] = "Para Yatır";
}

<div class="form-auth">
    <div class="card p-4">
        <h3 class="mb-1">Para Yatır</h3>
        <p class="text-muted small mb-3">
            @Model.AccountName<br />
            <span class="iban">@(Model.Iban is null ? "" : Fmt.Iban(Model.Iban))</span>
        </p>
        <div class="alert alert-light small">Demo amaçlıdır: ATM'den para yatırma işlemini simüle eder.</div>
        <form asp-action="Deposit" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
            <input type="hidden" asp-for="AccountId" />
            <input type="hidden" asp-for="AccountName" />
            <input type="hidden" asp-for="Iban" />
            <div class="mb-3">
                <label asp-for="Amount" class="form-label"></label>
                <input asp-for="Amount" type="number" step="0.01" min="0.01" value="@Model.Amount?.ToString(CultureInfo.InvariantCulture)" class="form-control" autofocus />
                <span asp-validation-for="Amount" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Yatır</button>
            <a asp-action="Details" asp-route-id="@Model.AccountId" class="btn btn-link w-100 mt-1">Vazgeç</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
