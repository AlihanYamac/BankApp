@model AccountDetailsViewModel
@{
    ViewData["Title"] = Model.Account.Name;
}

<a asp-action="Index" class="small">&larr; Hesaplarım</a>

<div class="card my-3">
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h3 class="mb-1">@Model.Account.Name</h3>
            <div class="iban text-muted">@Fmt.Iban(Model.Account.Iban)</div>
        </div>
        <div class="text-end">
            <div class="text-muted small">Bakiye</div>
            <div class="fs-3 fw-semibold">@Fmt.Money(Model.Account.Balance)</div>
        </div>
    </div>
    <div class="card-footer bg-transparent d-flex gap-2">
        <a class="btn btn-sm btn-outline-secondary" asp-action="Deposit" asp-route-id="@Model.Account.Id">Para Yatır</a>
        <a class="btn btn-sm btn-primary" asp-controller="Transfers" asp-action="Create" asp-route-fromAccountId="@Model.Account.Id">Para Gönder</a>
    </div>
</div>

<h4 class="mt-4">Hesap Hareketleri</h4>

@if (Model.Transactions.Count == 0)
{
    <div class="alert alert-light">Bu hesapta henüz hareket yok.</div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Tarih</th>
                        <th>İşlem</th>
                        <th>Açıklama</th>
                        <th>Karşı Taraf</th>
                        <th class="text-end">Tutar</th>
                        <th class="text-end">Bakiye</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Transactions)
                    {
                        <tr class="@(t.Type == TransactionType.Commission ? "row-commission" : "")">
                            <td class="text-nowrap small">@Fmt.Date(t.CreatedAt)</td>
                            <td>
                                <span class="badge @(t.Type switch {
                                    TransactionType.Commission => "text-bg-warning",
                                    TransactionType.TransferIn or TransactionType.Deposit => "text-bg-success",
                                    _ => "text-bg-secondary" })">
                                    @Fmt.TransactionTypeName(t.Type)
                                </span>
                            </td>
                            <td>
                                @t.Description
                                @if (t.ReferenceNo is not null)
                                {
                                    <div class="text-muted small">Ref: @t.ReferenceNo</div>
                                }
                            </td>
                            <td class="small">
                                @if (t.CounterpartyName is not null)
                                {
                                    <div>@t.CounterpartyName</div>
                                    <div class="iban text-muted">@Fmt.Iban(t.CounterpartyIban!)</div>
                                }
                            </td>
                            <td class="text-end text-nowrap @(t.Amount >= 0 ? "amount-in" : "amount-out")">@Fmt.SignedMoney(t.Amount)</td>
                            <td class="text-end text-nowrap">@Fmt.Money(t.BalanceAfter)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
